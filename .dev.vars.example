# Copy to .dev.vars for the local Workers preview (`npm run cf:preview`). Never commit .dev.vars.
# These override the "vars" in wrangler.jsonc on this machine only. On Cloudflare, secrets are set
# with `wrangler secret put <NAME>` and everything else lives in wrangler.jsonc.

# Tells OpenNext which .env files Next would load. Keep as is.
NEXTJS_ENV=development

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=replace-with-64-hex-chars

# local, staging or test turn on the preview behaviour (D41). The deployed Worker uses "production".
APP_ENV=local

# Empty switches the CSRF allowlist off so the admin logs in at http://localhost:8799.
NEXT_PUBLIC_SITE_URL=

# Clover payments in the local Workers preview (D54). Sandbox keys only; leave unset for the test payment.
# CLOVER_ECOMM_ENVIRONMENT=sandbox
# CLOVER_ECOMM_PUBLIC_KEY=
# CLOVER_ECOMM_PRIVATE_TOKEN=
# CLOVER_ECOMM_MERCHANT_ID=
# CLOVER_ECOMM_APPLE_PAY=on   (D59; needs the merchant id and a verified domain)
