# Copy to .env for local development. Never commit .env. No production secrets belong here.

# Local site
LDL_SITE_URL=http://localhost:8080
LDL_PORT=8080
LDL_ADMIN_USER=admin
LDL_ADMIN_EMAIL=admin@example.test
# Leave empty to have setup generate one and print it once.
LDL_ADMIN_PASSWORD=

# Local MariaDB (started by bin/setup-local.sh inside .local/, not a system service)
LDL_DB_NAME=lodelicious
LDL_DB_USER=lodelicious
LDL_DB_PASSWORD=local-only-password
LDL_DB_PORT=3307

# Pinned platform versions (verified available 2026-09-25)
LDL_WP_VERSION=7.1.2
LDL_WC_VERSION=11.1.2
LDL_WPCLI_VERSION=2.12.0

# Provider credentials — later phases. Test/sandbox values only in non-production environments.
# Production values go in wp-config.php outside the web root, never in this repository.
CLOVER_ENVIRONMENT=sandbox
CLOVER_MERCHANT_ID=
CLOVER_PUBLIC_TOKEN=
CLOVER_PRIVATE_TOKEN=
CLOVER_WEBHOOK_SECRET=
USPS_CLIENT_ID=
USPS_CLIENT_SECRET=
SKUIQ_ACCOUNT=
