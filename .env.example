# Copy to .env for local development. Never commit .env. No production secrets belong here.

# --- Payload / DB ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=replace-with-64-hex-chars
# libSQL/SQLite file. On cPanel use an ABSOLUTE path outside public_html.
DATABASE_URI=file:./.data/lodelicious.db
# Private, persistent data dir (DB + media). On cPanel: absolute path outside public_html.
DATA_DIR=./.data
MEDIA_DIR=./.data/media

# --- Site ---
# The public https address (comma-separate to add www). When set, Payload accepts cookie-authenticated
# API calls only from this origin (CSRF allowlist), so set it on the live and staging hosts. Leave it
# unset for local development and tunnels, or the admin will not log in from another address.
# NEXT_PUBLIC_SITE_URL=https://souset-pink.com
# What this server is. Only "local", "staging" and "test" switch on the test payment provider,
# unapproved photos, the staging banner, draft policies and PREVIEW_ASSUME_STOCK. Anything else,
# including leaving it unset, is treated as the live store. SET APP_ENV=production ON THE LIVE HOST
# (also when running `npm run build`, which decides the HSTS header), and check it at /ops/system-check.
APP_ENV=local
# Staging review only: treat uncounted stock as available so the basket builder can be tried.
# Ignored unless APP_ENV is local, staging or test.
# PREVIEW_ASSUME_STOCK=true

# --- First owner (set before the site is reachable) ---
# Only this address can create the very first account, including through /admin. Keep it set.
# FIRST_OWNER_EMAIL=lody@example.com
# To create that owner without opening /admin: set both, run `npx payload run scripts/create-owner.ts`,
# then delete OWNER_PASSWORD (12+ characters).
# OWNER_EMAIL=lody@example.com
# OWNER_PASSWORD=
# Seeding a production database that already has products needs this:
# SEED_FORCE=1
# Production only (set in the cPanel Node app): cap the V8 heap inside the 2 GB account limit.
# NODE_OPTIONS=--max-old-space-size=768

# --- Clover (later phase; sandbox values only outside production) ---
CLOVER_ENVIRONMENT=sandbox
CLOVER_MERCHANT_ID=
CLOVER_API_TOKEN=
CLOVER_PUBLIC_TOKEN=
CLOVER_WEBHOOK_SECRET=

# --- USPS (later phase) ---
USPS_CLIENT_ID=
USPS_CLIENT_SECRET=
