# Copy to .env for local development on Node. Never commit .env. No production secrets belong here.
# The Cloudflare host does not read this file (D49): its settings are "vars" in wrangler.jsonc plus
# `wrangler secret put`, and the local Workers preview reads .dev.vars (see .dev.vars.example).

# --- Payload / DB ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=replace-with-64-hex-chars
# libSQL/SQLite file (Node only; Cloudflare uses the D1 binding). On a shared host use an ABSOLUTE path outside the web root.
DATABASE_URI=file:./.data/lodelicious.db
# Private, persistent data dir (DB + media; Node only, Cloudflare uses D1 and R2). On a shared host: absolute path outside the web root.
DATA_DIR=./.data
MEDIA_DIR=./.data/media

# --- Site ---
# The public https address (comma-separate to add www). When set, Payload accepts cookie-authenticated
# API calls only from this origin (CSRF allowlist), so set it on the live and staging hosts. Leave it
# unset for local development and tunnels, or the admin will not log in from another address.
# NEXT_PUBLIC_SITE_URL=https://souset-pink.com
# What this server is. Only "local", "staging" and "test" switch on the test payment provider,
# unapproved photos, the staging banner, draft policies and PREVIEW_ASSUME_STOCK. Anything else,
# including leaving it unset, is treated as the live store. SET APP_ENV=production ON THE LIVE HOST
# (also when running `npm run build`, which decides the HSTS header), and check it at /ops/system-check.
APP_ENV=local
# Staging review only: treat uncounted stock as available so the basket builder can be tried.
# Ignored unless APP_ENV is local, staging or test.
# PREVIEW_ASSUME_STOCK=true

# --- First owner (set before the site is reachable) ---
# Only this address can create the very first account, including through /admin. Keep it set.
# FIRST_OWNER_EMAIL=lody@example.com
# To create that owner without opening /admin: set both, run `npx payload run scripts/create-owner.ts`,
# then delete OWNER_PASSWORD (12+ characters).
# OWNER_EMAIL=lody@example.com
# OWNER_PASSWORD=
# Seeding a production database that already has products needs this:
# SEED_FORCE=1
# Node host with a memory limit only (not Cloudflare): cap the V8 heap, e.g. inside a 2 GB account limit.
# NODE_OPTIONS=--max-old-space-size=768

# --- Clover payments (D54): the embedded card form and Clover's ecommerce API ---
# Set all three to take card payments. Unset: the test payment on local/staging, "call to order" live.
# The live store refuses CLOVER_ECOMM_ENVIRONMENT=sandbox. Never put production keys in this file.
# CLOVER_ECOMM_ENVIRONMENT=sandbox
# CLOVER_ECOMM_PUBLIC_KEY=
# CLOVER_ECOMM_PRIVATE_TOKEN=
# Optional, not secret: the merchant id Clover's iframe SDK asks for (reCAPTCHA and other features).
# CLOVER_ECOMM_MERCHANT_ID=
# Apple Pay through Clover's iframe (D59): "on" shows the button on devices with Apple Pay. Needs
# CLOVER_ECOMM_MERCHANT_ID, and the domain verified with Clover first.
# CLOVER_ECOMM_APPLE_PAY=on
# How long to wait for Clover before a payment counts as "unknown" (ms, default 30000).
# PAYMENT_TIMEOUT_MS=30000

# --- Print paid web orders on the Clover device (D60). Off unless "on". ---
# Needs a Clover merchant API token with "Orders: Read and Write" (Clover web dashboard → Account & Setup
# → API Tokens). Falls back to CLOVER_API_TOKEN; the merchant id falls back to CLOVER_ECOMM_MERCHANT_ID,
# the environment to CLOVER_ECOMM_ENVIRONMENT. Never creates inventory items. See docs/clover-order-printing.md.
# CLOVER_ORDER_PRINT=on
# CLOVER_ORDER_PRINT_TOKEN=
# CLOVER_ORDER_PRINT_ENVIRONMENT=sandbox

# --- Clover inventory sync (D43; sandbox values only outside production) ---
CLOVER_ENVIRONMENT=sandbox
CLOVER_MERCHANT_ID=
CLOVER_API_TOKEN=
CLOVER_PUBLIC_TOKEN=
CLOVER_WEBHOOK_SECRET=

# --- USPS (later phase) ---
USPS_CLIENT_ID=
USPS_CLIENT_SECRET=

# --- Transactional email (D44) ---
# Unset or "console": emails are only written to the log; nothing is sent. This is the default.
# "smtp" will not start unless every variable below is set, and on the live store also EMAIL_SEND_LIVE=1.
# (The SMTP adapter is still a stub: @payloadcms/email-nodemailer is not installed. See src/lib/email/adapter.ts.)
# EMAIL_TRANSPORT=console
# EMAIL_FROM="Souset-Pink <orders@your-verified-domain>"
# Where customer replies go. Defaults to the shop email in Store settings.
# EMAIL_REPLY_TO=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=0
# EMAIL_SEND_LIVE=1
# Sent by the send-pending-emails job every 10 minutes (a Cron Trigger on Cloudflare; on Node: npx payload run scripts/send-pending-emails.ts)
