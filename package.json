{
  "name": "lodelicious",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "npm run migrate && next dev",
    "build": "next build --webpack",
    "start": "next start",
    "serve": "node server.js",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "migrate": "payload migrate && payload run scripts/check-migrations.ts",
    "doctor": "payload run scripts/doctor.ts",
    "seed:sources": "npm run migrate && payload run scripts/seed-source-records.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:catalog": "npm run migrate && payload run scripts/seed-catalog.ts",
    "seed:reviews": "npm run migrate && payload run scripts/seed-google-reviews.ts",
    "migrate:check": "payload run scripts/check-migrations.ts",
    "cf:build": "DEPLOY_TARGET=cloudflare opennextjs-cloudflare build && node scripts/cf-strip-env.mjs",
    "cf:preview": "DEPLOY_TARGET=cloudflare opennextjs-cloudflare preview --port 8799",
    "cf:migrate": "DEPLOY_TARGET=cloudflare npm run migrate",
    "cf:migrate:remote": "DEPLOY_TARGET=cloudflare CLOUDFLARE_ENV=remote NODE_ENV=production npm run migrate",
    "cf:deploy": "APP_ENV=production npm run cf:build && DEPLOY_TARGET=cloudflare opennextjs-cloudflare deploy",
    "cf:size": "wrangler deploy --dry-run --outdir .wrangler/size-check"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.7",
    "@payloadcms/db-d1-sqlite": "3.90.2",
    "@payloadcms/db-sqlite": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/storage-r2": "3.90.2",
    "graphql": "^16.14.1",
    "next": "16.3.6",
    "payload": "3.90.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.8",
    "wrangler": "^4.160.0",
    "yaml": "^2.9.1"
  }
}
